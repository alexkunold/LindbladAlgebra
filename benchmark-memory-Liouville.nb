     RowBox[{"MaxMemoryUsed", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"ExpToTrig", "[", 
           RowBox[{"ProjectOperatorOntoBasis", "[", 
            RowBox[{"Hi", ",", "h"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalGamma]1", "=", 
        RowBox[{"GammaFromgamma", "[", 
         RowBox[{"h", ",", "\[Gamma]1", ",", "J1", ",", "J1t"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"\[CapitalGamma]2", "=", 
        RowBox[{"GammaFromgamma", "[", 
         RowBox[{"h", ",", "\[Gamma]2", ",", "J2", ",", "J2t"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"\[CapitalGamma]", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"\[CapitalGamma]1", "+", "\[CapitalGamma]2"}], "]"}], 
         "]"}]}], ";"}], "\[IndentingNewLine]", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Common:\>\"", ",", "mem11"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Common Standard:\>\"", ",", "mem12"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Common Direct and Algebraic:\>\"", ",", "mem13"}], "]"}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{"algebraic", ",", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Algebraic\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mem2", "=", 
        RowBox[{"MaxMemoryUsed", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"z", "=", 
           RowBox[{"ZStructureConstantsFromQubits", "[", "nq", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "=", 
           RowBox[{"XBasisFromQubits", "[", "nq", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[CapitalLambda]", "=", 
           RowBox[{"LambdaFromHamiltonianLindbladian", "[", 
            RowBox[{"z", ",", "H", ",", "\[CapitalGamma]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Lam", "=", 
           RowBox[{"LiouvilleSOFromLamda", "[", 
            RowBox[{"x", ",", "\[CapitalLambda]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Algebraic:\>\"", ",", "mem2"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mem3", "=", 
        RowBox[{"ByteCount", "[", "Lam", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Algebraic:\>\"", ",", "mem3"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{"direct", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Direct\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mem4", "=", 
        RowBox[{"MaxMemoryUsed", "[", 
         RowBox[{
          RowBox[{"Ldm", "=", 
           RowBox[{"LiouvilleSOFromProjection", "[", 
            RowBox[{"h", ",", "H", ",", "\[CapitalGamma]"}], "]"}]}], ";"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mem5", "=", 
        RowBox[{"ByteCount", "[", "Ldm", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Direct:\>\"", ",", "mem4"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Direct:\>\"", ",", "mem5"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{"standard", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Standard\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mem6", "=", 
        RowBox[{"MaxMemoryUsed", "[", 
         RowBox[{
          RowBox[{"Lsm", "=", 
           RowBox[{"LiouvilleStandardKronecker", "[", 
            RowBox[{
            "Hi", ",", "\[ScriptCapitalI]", ",", "\[Gamma]1", ",", "J1", ",", 
             "J1t", ",", "J1s", ",", "J1T", ",", "\[Gamma]2", ",", "J2", ",", 
             "J2t", ",", "J2s", ",", "J2T"}], "]"}]}], ";"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mem7", "=", 
        RowBox[{"ByteCount", "[", "Lsm", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Standard:\>\"", ",", 
         RowBox[{"mem11", "+", "mem12", "+", "mem6"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Standard:\>\"", ",", "mem7"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"nq", ",", "1", ",", "6"}], "}"}]}], "]"}]}], "Input",
