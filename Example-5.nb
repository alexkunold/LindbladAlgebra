         Rational[-1, 2]) $CellContext`\[CapitalOmega] 
       Sin[3 $CellContext`t $CellContext`\[Alpha] + $CellContext`t \
$CellContext`\[CapitalDelta] + $CellContext`\[Phi]], (-2^
         Rational[-1, 2]) $CellContext`\[CapitalOmega] 
       Cos[3 $CellContext`t $CellContext`\[Alpha] + $CellContext`t \
$CellContext`\[CapitalDelta] + $CellContext`\[Phi]], 
       2^Rational[-1, 2] $CellContext`\[CapitalOmega] 
       Sin[3 $CellContext`t $CellContext`\[Alpha] + $CellContext`t \
$CellContext`\[CapitalDelta] + $CellContext`\[Phi]], 
       2^Rational[-1, 2] $CellContext`\[CapitalOmega] 
       Cos[3 $CellContext`t $CellContext`\[Alpha] + $CellContext`t \
$CellContext`\[CapitalDelta] + $CellContext`\[Phi]], 
       2^Rational[-1, 2] $CellContext`\[CapitalOmega] 
       Cos[3 $CellContext`t $CellContext`\[Alpha] + $CellContext`t \
$CellContext`\[CapitalDelta] + $CellContext`\[Phi]], (-2^
         Rational[-1, 2]) $CellContext`\[CapitalOmega] 
       Sin[3 $CellContext`t $CellContext`\[Alpha] + $CellContext`t \
$CellContext`\[CapitalDelta] + $CellContext`\[Phi]]}}]]]]], "Output",
 CellChangeTimes->{{3.990013719484688*^9, 3.990013744285631*^9}, {
