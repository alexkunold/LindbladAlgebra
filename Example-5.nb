      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "H", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"trGZ", "=", 
       RowBox[{"TensorContract", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "\[CapitalGamma]", "]"}], ".", "Z"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{"\[CapitalGamma]", "+", 
        RowBox[{
         RadicalBox["n", "4"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "H"}], "-", 
               RowBox[{
                FractionBox["1", "4"], "trGZ"}]}], ")"}], ",", 
             RowBox[{"SparseArray", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", "\[Rule]", "1"}], "}"}], ",", "n"}], "]"}]}], 
            "]"}], "+", 
           RowBox[{"-", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"SparseArray", "[", 
