Cell[TextData[{
 " We then transform it from the matrix basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicE]", "n"], TraditionalForm]],ExpressionUUID->
  "430f9fd3-becb-446a-84ae-2ec8fbcea2da"],
 ", defined in Eq. (12), to the basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[GothicH]",
     FontWeight->"Bold"], "n"], TraditionalForm]],ExpressionUUID->
  "b385c6cf-9162-4f0a-9268-ca4f0277f2a3"],
 " using the unitary transformation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "82975249-44e8-4fcc-b169-e07467ac84f6"],
 "=tr[",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],ExpressionUUID->
  "bd8f5b29-5231-4310-819d-0f07aa02581c"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "j"], TraditionalForm]],ExpressionUUID->
  "4a57bc98-4833-41b1-ae0f-b830a52356f7"],
 "]"
}], "Text",
 CellChangeTimes->{
  4.001771112324121*^9},ExpressionUUID->"2c5205a9-3686-429d-8a92-\
d03ca98bf614"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{"ElementaryBasis", "[", "m", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"h", ".", 
      RowBox[{"Transpose", "[", "e", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ut", "=", 
   RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Lsmh", "=", 
  RowBox[{"u", ".", 
   RowBox[{"(", 
    RowBox[{"Lsme", ".", "ut"}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{4.001763969511879*^9, 4.0017639907045507`*^9}, {
  4.0017640271236897`*^9, 4.0017640459463778`*^9}, {4.001764102824362*^9, 
  4.001764121572733*^9}, {4.001764338174148*^9, 4.0017643803666697`*^9}, {
