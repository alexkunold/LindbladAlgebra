Cell[CellGroupData[{

Cell["\<\
Comparison of the algebraic method with the standard Kronecker product method\
\
\>", "Subsection",
 CellChangeTimes->{{3.990810498385676*^9, 3.990810522534274*^9}, {
  4.001770039919799*^9, 
  4.0017700577094088`*^9}},ExpressionUUID->"fddac2bf-68a3-4c29-890a-\
7833430e2d68"],

Cell["\<\
To compare the Liouville superoperators obtained using the algebraic and \
standard Kronecker product methods, we first construct the Kronecker \
representation using Eqs. (21) and (22).\
\>", "Text",
 CellChangeTimes->{{4.001770770899067*^9, 4.001770838685466*^9}, 
   4.001770894657858*^9},ExpressionUUID->"146c4c7f-1178-4e9a-a26c-\
597c53a37051"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalI]", " ", "=", 
   RowBox[{"SparseArray", "[", " ", 
    RowBox[{"IdentityMatrix", "[", "m", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J1T", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"n", "+", "1"}], ",", "n"}], "}"}], "->", 
        RowBox[{
         SqrtBox["n"], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Alpha]", " ", "n", " ", 
           "t"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "-", "1"}], ",", "m", ",", "m"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J1s", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", "n", ",", 
          RowBox[{"n", "+", "1"}]}], "}"}], "->", 
        RowBox[{
         SqrtBox["n"], 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Alpha]", " ", "n", " ", "t"}], 
          "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "-", "1"}], ",", "m", ",", "m"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J2T", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"J2", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J2s", "=", 
   RowBox[{"Conjugate", "[", "J2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Lsme", "=", 
  RowBox[{"LiouvilleStandardKronecker", "[", 
   RowBox[{
   "Hi", ",", "\[ScriptCapitalI]", ",", "\[Gamma]1", ",", "J1", ",", "J1t", ",",
     "J1s", ",", "J1T", ",", "\[Gamma]2", ",", "J2", ",", "J2t", ",", "J2s", ",",
     "J2T"}], "]"}]}]}], "Input",
 CellChangeTimes->{4.001770899467009*^9},
 CellLabel->"In[67]:=",ExpressionUUID->"5e12bf46-fe6e-4140-8878-65ea852b2eb5"],

