Cell[CellGroupData[{

Cell["Algebraic Method", "Subsection",
 CellChangeTimes->{{3.99009876000539*^9, 
  3.990098763820292*^9}},ExpressionUUID->"4d271bc6-bd26-470d-ab30-\
72ad9ab82575"],

Cell[TextData[{
 "Having obtained the quantities required to construct the Hamiltonian and \
Lindbladian contributions to the Liouville superoperator, namely ",
 StyleBox["H",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " and \[CapitalGamma], we can proceed to compute \[CapitalLambda] using Eq. \
(60), yielding"
}], "Text",
 CellChangeTimes->{{3.990804245825198*^9, 3.99080431186313*^9}, {
  4.0000676917338*^9, 
  4.000067692235898*^9}},ExpressionUUID->"103c2abc-9a8e-4472-a16c-\
0e40a400c955"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[CapitalLambda]", "=", 
  RowBox[{"LambdaFromHamiltonianLindbladian", "[", 
   RowBox[{"z", ",", "H", ",", "\[CapitalGamma]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9908043333465757`*^9, 3.9908043472726316`*^9}, {
  4.001774194297093*^9, 4.001774194715255*^9}},
