     E^(Complex[0, -6] $CellContext`t $CellContext`\[Alpha] + 
       Complex[0, -1] ($CellContext`t $CellContext`\[CapitalDelta] + \
$CellContext`\[Phi])) $CellContext`\[CapitalOmega], Complex[0, -1] 
     Rational[3, 2]^Rational[1, 2] 
     E^(Complex[0, 5] $CellContext`t $CellContext`\[Alpha] + 
       Complex[0, 
          1] ($CellContext`t $CellContext`\[CapitalDelta] + $CellContext`\
\[Phi])) $CellContext`\[CapitalOmega], Complex[0, Rational[-1, 2]] 
     7^Rational[1, 2] 
     E^(Complex[0, -6] $CellContext`t $CellContext`\[Alpha] + 
       Complex[0, -1] ($CellContext`t $CellContext`\[CapitalDelta] + \
$CellContext`\[Phi])) $CellContext`\[CapitalOmega], 
     Rational[-7, 2] $CellContext`\[Gamma]10, Complex[0, Rational[1, 2]] 
     7^Rational[1, 2] 
     E^(Complex[0, -6] $CellContext`t $CellContext`\[Alpha] + 
       Complex[0, -1] ($CellContext`t $CellContext`\[CapitalDelta] + \
$CellContext`\[Phi])) $CellContext`\[CapitalOmega], 
     Complex[0, Rational[-1, 2]] 7^Rational[1, 2] 
     E^(Complex[0, 6] $CellContext`t $CellContext`\[Alpha] + 
       Complex[0, 
          1] ($CellContext`t $CellContext`\[CapitalDelta] + $CellContext`\
\[Phi])) $CellContext`\[CapitalOmega]}}],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
