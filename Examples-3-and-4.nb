              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[ImaginaryI]", " ", "H"}], "+", 
                RowBox[{
                 FractionBox["1", "4"], "trGZ"}]}], ")"}]}], "]"}]}]}], 
          ")"}]}]}], ")"}]}]}], "\[IndentingNewLine]", "]"}]}], 
