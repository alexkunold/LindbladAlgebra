 RowBox[{
  RowBox[{"\[CapitalDelta]0", " ", "=", " ", "0.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]0", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"constants", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "\[Rule]", "\[Alpha]0"}], ",", 
     RowBox[{"\[CapitalDelta]", "\[Rule]", "\[CapitalDelta]0"}], ",", 
     RowBox[{"\[CapitalOmega]", "\[Rule]", 
      RowBox[{
       FractionBox["\[CapitalOmega]0", 
        RowBox[{"2", 
         SqrtBox[
          RowBox[{"2", "\[Pi]"}]]}]], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"t", "-", "t0"}], "\[Sigma]"], ")"}], "2"]}], "]"}]}]}], ",", 
     RowBox[{"\[Phi]", "\[Rule]", "\[Phi]0"}], ",", 
     RowBox[{"\[Gamma]10", "\[Rule]", "0"}], ",", 
     RowBox[{"\[Gamma]20", "\[Rule]", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqsn", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"eqs", "/.", "constants"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialcond", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Normal", "[", "fV", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "0"}], "}"}]}], ")"}], "==", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "1", "}"}], "->", "4"}], ",", 
       SuperscriptBox["n", "2"]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diffeqsn", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"eqsn", ",", "initialcond"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"diffeqsn", ",", 
      RowBox[{"Normal", "[", "fV", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jtn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", "Jt", "]"}], "/.", "sol"}], "/.", 
    RowBox[{"{", 
     RowBox[{"t", "\[Rule]", 
      RowBox[{"tmin", "+", 
       RowBox[{"0.5", 
        RowBox[{"(", 
         RowBox[{"tmax", "-", "tmin"}], ")"}]}]}]}], "}"}]}]}], 
  ";"}]}], "Input",
