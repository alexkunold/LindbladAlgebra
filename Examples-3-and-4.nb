     RowBox[{"at", ".", "a"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J2t", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{"at", ".", "a"}], "}"}], "]"}]}], ";"}]}], "Input",
