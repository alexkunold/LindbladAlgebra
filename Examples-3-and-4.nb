  RowBox[{"SparseArray", "[", 
   RowBox[{"anticommu", "-", 
    RowBox[{
     FractionBox["1", "4"], 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"zt", ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"x", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "4", ",", "2", ",", "3"}], "}"}]}], "]"}], ".",
           "z"}], "+", 
         RowBox[{"z", ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"x", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "4", ",", "2", ",", "3"}], "}"}]}], "]"}], ".",
           "zt"}]}], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3", ",", "5", ",", "6", ",", "2", ",", "4"}], 
