Cell["\<\
These tests can also be performed in two special cases: (i) with the drive \
turned off; and (ii) with the Kossakowski matrix set to zero, yielding a \
unitary channel.\
\>", "Text",
 CellChangeTimes->{{4.001864082281296*^9, 4.001864113506687*^9}, {
   4.001864151970037*^9, 4.001864260809589*^9}, 4.0018643426163177`*^9, {
   4.001865132499898*^9, 4.0018651344883347`*^9}, {4.0018654230257463`*^9, 
   4.001865434903274*^9}},ExpressionUUID->"6f51e241-179b-4c13-9562-\
2dab37c46742"],

Cell[CellGroupData[{

Cell["(i) drive turned off", "Subsubsection",
 CellChangeTimes->{{4.001864370686142*^9, 
  4.001864380386628*^9}},ExpressionUUID->"3cb222c4-6518-425f-9dc3-\
1dd1aa911295"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]0", " ", "=", 
   RowBox[{"2", "\[Pi]", " ", "0.05"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]0", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], "\[Pi]", " ", "0.3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]0", " ", "=", " ", 
   RowBox[{"2", "\[Pi]", " ", "3.0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"150.0", " ", 
    SuperscriptBox["10", "3"]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T2", "=", 
   RowBox[{"100.0", " ", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]10", "=", 
   RowBox[{"2", "/", "T1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]20", "=", 
   RowBox[{
    FractionBox["4", "T2"], "-", 
    FractionBox["2", 
     RowBox[{" ", "T1"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]", " ", "=", " ", 
   RowBox[{"2", 
    RowBox[{"\[Pi]", "/", "\[CapitalOmega]0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"4", "\[Sigma]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmin", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", 
   RowBox[{"8", "\[Sigma]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]0", " ", "=", " ", "0.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]0", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"constants", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "\[Rule]", "\[Alpha]0"}], ",", 
     RowBox[{"\[CapitalDelta]", "\[Rule]", "\[CapitalDelta]0"}], ",", 
     RowBox[{"\[CapitalOmega]", "\[Rule]", "0"}], ",", 
     RowBox[{"\[Phi]", "\[Rule]", "\[Phi]0"}], ",", 
     RowBox[{"\[Gamma]10", "\[Rule]", "\[CapitalGamma]10"}], ",", 
     RowBox[{"\[Gamma]20", "\[Rule]", "\[CapitalGamma]20"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqsn", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"eqs", "/.", "constants"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialcond", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Normal", "[", "fV", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "0"}], "}"}]}], ")"}], "==", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "1", "}"}], "->", "4"}], ",", 
       SuperscriptBox["n", "2"]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diffeqsn", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"eqsn", ",", "initialcond"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"diffeqsn", ",", 
      RowBox[{"Normal", "[", "fV", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jtn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", "Jt", "]"}], "/.", "sol"}], "/.", 
    RowBox[{"{", 
     RowBox[{"t", "\[Rule]", 
      RowBox[{"tmin", "+", 
       RowBox[{"0.5", 
        RowBox[{"(", 
         RowBox[{"tmax", "-", "tmin"}], ")"}]}]}]}], "}"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.00186443326054*^9, 4.001864433853401*^9}, {
  4.0018644673869553`*^9, 4.001864484163454*^9}, {4.001864523552643*^9, 
