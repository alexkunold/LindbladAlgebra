      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "H", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"trGZ", "=", 
       RowBox[{"TensorContract", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "\[CapitalGamma]", "]"}], ".", "Z"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{"\[CapitalGamma]", "+", 
        RowBox[{
         RadicalBox["n", "4"], 
