 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", "2"], "=", 
    RowBox[{
     RowBox[{"4", "/", 
      SubscriptBox["T", "1"]}], "-", 
