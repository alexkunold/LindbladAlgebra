Cell[TextData[{
 "The orthonormality of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicCapitalX]", 
    SuperscriptBox["n", "2"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5758c731-d313-4680-9983-4755bbeb2c3b"],
 " is verified by flattening the first two indices of ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " into a single index and then evaluating the Hilbert-Schmidt inner product"
}], "Text",
 CellChangeTimes->{{3.9907966719070187`*^9, 3.990796771926888*^9}, {
  3.990798475226843*^9, 
  3.990798480302998*^9}},ExpressionUUID->"a27f000f-da5f-4d1e-b3a4-\
a0b30bf5070e"],

