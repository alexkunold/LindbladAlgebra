   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{"at", ".", "a"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J2t", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{"at", ".", "a"}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.999528816007627*^9, 3.999528816010934*^9}, {
  3.999528952793171*^9, 3.999528962170874*^9}, {3.999529124451375*^9, 
  3.9995291276320677`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"70a053a3-17b1-4216-ba17-5565d69a951b"],

Cell[TextData[{
 "and the pure-dephasing time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "2"], TraditionalForm]],ExpressionUUID->
  "0faef27f-7c1f-4f08-a7c0-adbfbdfcab83"],
 " or rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", "2"], "=", 
    RowBox[{
     RowBox[{"1", "/", 
      SubscriptBox["T", "1"]}], "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], 
      SubscriptBox["T", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "ab546144-f736-4379-bb07-7f944f65b969"],
 "  which is associated"
}], "Text",
