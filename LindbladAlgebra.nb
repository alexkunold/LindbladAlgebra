  3.9995291276320677`*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"ca4ec0c6-6791-4827-af54-82edc0527ecf"],

Cell[TextData[{
 "and the pure-dephasing time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "2"], TraditionalForm]],ExpressionUUID->
  "a99d4a11-a143-49e9-9ad2-aff97a5986d8"],
 " or rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", "2"], "=", 
    RowBox[{
     RowBox[{"4", "/", 
      SubscriptBox["T", "1"]}], "-", 
     RowBox[{"2", "/", 
      SubscriptBox["T", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "07e22e83-24da-41db-aaf5-f3f8d1ffb2aa"],
 " which is associated"
}], "Text",
