 RowBox[{
  RowBox[{
   RowBox[{"XBasisFromQubits", "[", "nq_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", "c"}], "}"}], "=", 
       RowBox[{"BCStructureConstantsFromQubits", "[", "nq", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       FractionBox["1", "4"], 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "+", 
            RowBox[{"\[ImaginaryI]", " ", "c"}]}], ")"}], ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"b", "-", 
            RowBox[{"\[ImaginaryI]", " ", "c"}]}], "]"}]}], ",", 
         RowBox[{"{", 
