Cell[TextData[{
 "We begin by constructing the two-qubit basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[GothicH]",
     FontWeight->"Bold"], "n"], TraditionalForm]],ExpressionUUID->
  "15b9b478-90a2-4cb5-80f6-e189134a0f3d"],
 " and its associated structure constant superoperators ",
 StyleBox["Z",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ",",
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Z",
     FontWeight->"Bold"], "*"], TraditionalForm]],ExpressionUUID->
  "e56caefb-60ec-4e32-877b-84dcd1eb8d44"],
 " and ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.9907888603889503`*^9, 3.990788915754231*^9}, {
