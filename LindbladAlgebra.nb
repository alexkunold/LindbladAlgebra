  3.991220737746496*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"5bfde734-e90f-4fde-a5e6-e642907e1da1"],

Cell[TextData[{
 "We begin by constructing the one-qubit basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[GothicH]",
     FontWeight->"Bold"], "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39efec46-73c0-40d3-a8c4-806e13bae9a4"],
 " and its associated structure constant superoperators ",
 StyleBox["Z",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ",",
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Z",
     FontWeight->"Bold"], "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2028259-40ce-486f-bee1-b0ff8bdb5c73"],
 " and ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "."
}], "Text",
