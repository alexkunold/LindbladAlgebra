 RowBox[{
  RowBox[{"J2", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{"at", ".", "a"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J2t", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{"at", ".", "a"}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.999528816007627*^9, 3.999528816010934*^9}, {
