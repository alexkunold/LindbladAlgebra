 RowBox[{
  RowBox[{
   RowBox[{"LambdaFromHamiltonianLindbladian", "[", 
    RowBox[{"Z_", ",", "H_", ",", "\[CapitalGamma]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "trGZ"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "H", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"trGZ", "=", 
       RowBox[{"TensorContract", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "\[CapitalGamma]", "]"}], ".", "Z"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{"\[CapitalGamma]", "+", 
        RowBox[{
         RadicalBox["n", "4"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"SparseArray", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", "\[Rule]", "1"}], "}"}], ",", "n"}], "]"}], ",", 
             
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "H"}], "-", 
               RowBox[{
                FractionBox["1", "4"], "trGZ"}]}], ")"}]}], "]"}], "+", 
           RowBox[{"-", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[ImaginaryI]", " ", "H"}], "+", 
                RowBox[{
                 FractionBox["1", "4"], "trGZ"}]}], ")"}], ",", 
              RowBox[{"SparseArray", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", "\[Rule]", "1"}], "}"}], ",", "n"}], "]"}]}], 
             "]"}]}]}], ")"}]}]}], ")"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GammaFromgamma", "[", 
    RowBox[{"h_", ",", "\[Gamma]_", ",", "A_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "w", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"w", "=", 
       RowBox[{"TensorContract", "[", 
        RowBox[{
         RowBox[{"A", ".", 
          RowBox[{"Transpose", "[", "h", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "w", "]"}], ".", "\[Gamma]", ".", 
       "w"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LiouvilleSOFromProjection", "[", 
    RowBox[{"h_", ",", "H_", ",", "\[CapitalGamma]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "hhh", ",", "trhhh", ",", "trhhhhG", ",", "tc24trhhhhG", ",", 
       "tc14trhhhhG"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hhh", "=", 
       RowBox[{"h", ".", 
        RowBox[{"Transpose", "[", "h", "]"}], ".", 
        RowBox[{"Transpose", "[", "h", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"trhhh", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"TensorContract", "[", 
         RowBox[{"hhh", ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"2", ",", "5"}], "}"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"trhhhhG", "=", 
       RowBox[{
        RowBox[{"TensorContract", "[", 
         RowBox[{
          RowBox[{"hhh", ".", 
