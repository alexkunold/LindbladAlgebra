Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Gamma]", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ii", ",", "ii"}], "}"}], "->", "\[Gamma]0"}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "-", "1"}], ",", 
       RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalGamma]", "=", 
  RowBox[{"GammaFromgamma", "[", 
