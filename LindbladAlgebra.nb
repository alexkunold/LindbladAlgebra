Cell[TextData[{
 "Having obtained the quantities required to construct the Hamiltonian and \
Lindbladian contributions to the Liouville superoperator, namely ",
 StyleBox["H",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " and \[CapitalGamma], we can proceed to compute \[CapitalLambda] using Eq. \
(55), yielding"
}], "Text",
 CellChangeTimes->{{3.990804245825198*^9, 
  3.99080431186313*^9}},ExpressionUUID->"5e8f1a18-d4e1-4136-9151-\
cd1d972ce0f5"],

