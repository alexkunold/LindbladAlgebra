Cell[CellGroupData[{

Cell["Liouville equation for the dynamical map", "Subsection",
 CellChangeTimes->{{3.990811117238882*^9, 
  3.990811127679689*^9}},ExpressionUUID->"3a4775b2-11c3-4eda-92e4-\
1a62c661a8bf"],

Cell[TextData[{
 "To verify that the dynamical differential equations for the coordinate \
vector, Eq. (112), are equivalent to those derived from the Lindbladian, we \
directly project the Liouville operator acting on the dynamical map, as given \
on the right-hand side of Eq. (110), onto the basis ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". We then subtract the resulting expression from the right-hand side of Eq. \
(112), which should yield zero if both formulations are equivalent. First, we \
define the elements of the dynamical map as in Eq. (107)."
}], "Text",
 CellChangeTimes->{{3.9912148213661957`*^9, 3.991214907524946*^9}, {
   3.991215106411063*^9, 3.9912151636500387`*^9}, {3.991215334512278*^9, 
   3.991215363152875*^9}, {3.991215395263175*^9, 3.9912154387509947`*^9}, {
   3.9912155216302967`*^9, 3.9912156688579903`*^9}, 3.991215770303673*^9, {
   4.0000672854175663`*^9, 
   4.00006730156586*^9}},ExpressionUUID->"5f85a5b2-2cdd-42f0-a218-\
51e55086f3b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"V", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"Array", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", "##", "]"}], "[", "t", "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fV", "=", 
   RowBox[{"Flatten", "[", "V", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", ",", "c"}], "}"}], "=", 
   RowBox[{"BCStructureConstantsFromQubits", "[", "nq", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"ZStructureConstantsFromQubits", "[", "nq", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zt", "=", 
   RowBox[{"Conjugate", "[", "z", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.990816836988379*^9, 3.990816879196498*^9}, {
   3.990817063790866*^9, 3.9908170689201393`*^9}, {3.990817388048842*^9, 
   3.990817392459559*^9}, {3.990817425684067*^9, 3.990817447870356*^9}, {
   3.9908174913571568`*^9, 3.99081749417586*^9}, {3.990818896261354*^9, 
   3.9908189889050293`*^9}, {3.990820025899489*^9, 3.990820061711212*^9}, {
   3.990820128788583*^9, 3.9908201382405252`*^9}, {3.991211711714367*^9, 
   3.9912117122740183`*^9}, {3.99953573911345*^9, 3.999535748622967*^9}, 
   4.0014207632214813`*^9},
 CellLabel->"In[74]:=",ExpressionUUID->"0c54e2bf-82f9-4292-b5ca-544e58b994c9"],

Cell["\<\
We calculate the right-hand side of the dynamical differential equations \
using the algebraically derived Eq. (112).\
\>", "Text",
 CellChangeTimes->{{3.9912158389325027`*^9, 3.991215920298376*^9}, 
   3.991215950482933*^9, {4.0000673177668123`*^9, 
   4.000067318547965*^9}},ExpressionUUID->"4967fb51-16f2-4ed4-ad6b-\
96fa8453215f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiffEqsAlgebraicMethod", "=", 
  RowBox[{"SparseArray", "[", 
   RowBox[{"fV", ".", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{
          FractionBox["1", "4"], 
          RowBox[{"zt", ".", "\[CapitalLambda]", ".", "z"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
      "1"}], "]"}]}], "]"}]}]], "Input",
