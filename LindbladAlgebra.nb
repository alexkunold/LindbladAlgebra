         RowBox[{"x", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], "]"}], ".", 
        "Ldm"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
