 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"QubitBasis", "[", "nq", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", ",", "c"}], "}"}], "=", 
   RowBox[{"BCStructureConstantsFromQubits", "[", "nq", "]"}]}], ";"}], "\[IndentingNewLine]", 
