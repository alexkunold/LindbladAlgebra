Cell["\<\
In this section we create a series of Mathematica functions that facilitate \
the computation of the matrix basis, structure constants and Liouville \
superoperator.\
\>", "Text",
 CellChangeTimes->{{3.9908088746408377`*^9, 
  3.990808927713462*^9}},ExpressionUUID->"53626652-9abb-419d-9d75-\
41e359c96041"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"QubitBasis", "[", "nq_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h0", ",", "h1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h0", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
           FractionBox["1", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "2"}], "}"}], "\[Rule]", 
           FractionBox["1", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "1", ",", "2"}], "}"}], "\[Rule]", 
           FractionBox["1", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", "1"}], "}"}], "\[Rule]", 
           FractionBox["1", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "1", ",", "2"}], "}"}], "\[Rule]", 
           RowBox[{"-", 
            FractionBox["\[ImaginaryI]", 
             SqrtBox["2"]]}]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "2", ",", "1"}], "}"}], "\[Rule]", 
           FractionBox["\[ImaginaryI]", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"4", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
           FractionBox["1", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"4", ",", "2", ",", "2"}], "}"}], "\[Rule]", 
           RowBox[{"-", 
            FractionBox["1", 
             SqrtBox["2"]]}]}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"h1", "=", "h0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"h1", "=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"h1", ",", "h0"}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", 
          RowBox[{"nq", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "h1"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NStateBasis", "[", "nl_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sq2", ",", "vb", ",", "v", ",", "ars", ",", "splist", ",", "kk"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sq2", "=", 
       RowBox[{"1", "/", 
        SqrtBox["2"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vb", "=", 
       RowBox[{"{", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"1", ",", "nl"}], "]"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "nl"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"v", "[", 
           RowBox[{"[", "ii", "]"}], "]"}], "=", "1"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"vb", ",", "v"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
        
        RowBox[{"{", 
         RowBox[{"ii", ",", "nl", ",", "2", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ars", "=", 
       RowBox[{"ArrayRules", "[", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"Map", "[", 
          RowBox[{"DiagonalMatrix", ",", 
           RowBox[{"Orthogonalize", "[", "vb", "]"}]}], "]"}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"splist", "=", 
       RowBox[{"ars", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{
           RowBox[{"Length", "[", "ars", "]"}], "-", "1"}]}], "]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"kk", "=", "nl"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"kk", "+=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"splist", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"kk", ",", "ii", ",", "jj"}], "}"}], "->", "sq2"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"splist", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"kk", ",", "jj", ",", "ii"}], "}"}], "->", "sq2"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"kk", "+=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"splist", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"kk", ",", "ii", ",", "jj"}], "}"}], "->", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "sq2"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"splist", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"kk", ",", "jj", ",", "ii"}], "}"}], "->", 
            RowBox[{"\[ImaginaryI]", " ", "sq2"}]}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", "1", ",", 
          RowBox[{"nl", "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"jj", ",", 
          RowBox[{"ii", "+", "1"}], ",", "nl"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"splist", ",", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["nl", "2"], ",", "nl", ",", "nl"}], "}"}]}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCStructureConstantsFromBase", "[", "h_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hs", ",", "hhh", ",", "hhht"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hhh", "=", 
       RowBox[{"TensorContract", "[", 
        RowBox[{
         RowBox[{"h", ".", 
          RowBox[{"Transpose", "[", "h", "]"}], ".", 
          RowBox[{"Transpose", "[", "h", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"2", ",", "5"}], "}"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hhht", "=", 
       RowBox[{"Transpose", "[", "hhh", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{"hhh", "+", "hhht"}], "]"}], ",", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{"hhht", "-", "hhh"}], ")"}]}], "]"}]}], "}"}]}]}], "]"}]}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCStructureConstantsFromQubits", "[", "nq_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "h0", ",", "c0", ",", "b0", ",", "c1", ",", "b1", ",", "c2", ",", 
       "b2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h0", "=", 
       RowBox[{"QubitBasis", "[", "1", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b0", ",", "c0"}], "}"}], "=", 
       RowBox[{"BCStructureConstantsFromBase", "[", "h0", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b1", "=", "b0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"c1", "=", "c0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"b2", "=", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"b1", ",", "b0"}], "]"}], "-", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"c1", ",", "c0"}], "]"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"c2", "=", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"c1", ",", "b0"}], "]"}], "+", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"b1", ",", "c0"}], "]"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"b1", "=", "b2"}], ";", "\[IndentingNewLine]", 
         RowBox[{"c1", "=", "c2"}], ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", 
          RowBox[{"nq", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"b1", ",", "c1"}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ZStructureConstantFromBase", "[", "h_", "]"}], ":=", 
