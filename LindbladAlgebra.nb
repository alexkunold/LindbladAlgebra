Cell[TextData[{
 "The orthonormality of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicCapitalX]", 
    SuperscriptBox["n", "2"]], TraditionalForm]],ExpressionUUID->
  "4c093a4e-8fef-4c9f-82e0-3b51ea9b61a8"],
 " is verified by flattening the first two indices of ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " into a single index and then evaluating the Hilbert-Schmidt inner product"
}], "Text",
 CellChangeTimes->{{3.9907966719070187`*^9, 3.990796771926888*^9}, {
  3.990798475226843*^9, 
  3.990798480302998*^9}},ExpressionUUID->"d83e4055-20ea-4b40-a224-\
275aacbc20dc"],

