$CellContext`v[2, 3][$CellContext`t] + 
     Complex[0, Rational[-1, 8]] $CellContext`\[Gamma]10 $CellContext`v[
       2, 4][$CellContext`t] + 
     Rational[1, 8] $CellContext`\[Gamma]10 $CellContext`v[
       3, 1][$CellContext`t] + 
     Rational[1, 2] $CellContext`\[CapitalOmega] 
      Cos[$CellContext`t $CellContext`\[CapitalDelta] + $CellContext`\[Phi]] \
$CellContext`v[3, 3][$CellContext`t] + (
       Rational[-1, 8] $CellContext`\[Gamma]10 + 
       Rational[1, 16] (-$CellContext`\[Gamma]10 - $CellContext`\[Gamma]20) + 
       Rational[
         1, 16] ($CellContext`\[Gamma]10 + $CellContext`\[Gamma]20)) \
$CellContext`v[3, 4][$CellContext`t] + 
     Complex[0, Rational[-1, 2]] $CellContext`\[CapitalOmega] 
      Sin[$CellContext`t $CellContext`\[CapitalDelta] + $CellContext`\[Phi]] \
$CellContext`v[4, 1][$CellContext`t] + 
     Complex[0, Rational[1, 8]] $CellContext`\[Gamma]10 $CellContext`v[
       4, 2][$CellContext`t] + (Rational[-1, 8] $CellContext`\[Gamma]10 + 
       Rational[
         1, 8] (-$CellContext`\[Gamma]10 - $CellContext`\[Gamma]20)) \
$CellContext`v[4, 3][$CellContext`t] + 
     Rational[-1, 2] $CellContext`\[CapitalOmega] 
      Cos[$CellContext`t $CellContext`\[CapitalDelta] + $CellContext`\[Phi]] \
$CellContext`v[4, 4][$CellContext`t], (
       Rational[-1, 8] $CellContext`\[Gamma]10 + 
       Rational[
         1, 8] ($CellContext`\[Gamma]10 + $CellContext`\[Gamma]20)) \
$CellContext`v[1, 1][$CellContext`t] + 
     Rational[1, 8] $CellContext`\[Gamma]10 $CellContext`v[
       1, 4][$CellContext`t] + (Rational[1, 8] $CellContext`\[Gamma]10 + 
       Rational[1, 16] (-$CellContext`\[Gamma]10 - $CellContext`\[Gamma]20) + 
       Rational[
         1, 16] ($CellContext`\[Gamma]10 + $CellContext`\[Gamma]20)) \
$CellContext`v[2, 2][$CellContext`t] + 
     Complex[0, Rational[1, 8]] $CellContext`\[Gamma]10 $CellContext`v[
       2, 3][$CellContext`t] + 
     Rational[-1, 2] $CellContext`\[CapitalOmega] 
      Sin[$CellContext`t $CellContext`\[CapitalDelta] + $CellContext`\[Phi]] \
$CellContext`v[2, 4][$CellContext`t] + 
     Complex[0, Rational[-1, 8]] $CellContext`\[Gamma]10 $CellContext`v[
       3, 2][$CellContext`t] + (Rational[1, 8] $CellContext`\[Gamma]10 + 
       Rational[1, 16] (-$CellContext`\[Gamma]10 - $CellContext`\[Gamma]20) + 
       Rational[
         1, 16] ($CellContext`\[Gamma]10 + $CellContext`\[Gamma]20)) \
$CellContext`v[3, 3][$CellContext`t] + 
     Rational[1, 2] $CellContext`\[CapitalOmega] 
      Cos[$CellContext`t $CellContext`\[CapitalDelta] + $CellContext`\[Phi]] \
$CellContext`v[3, 4][$CellContext`t] + 
     Rational[1, 8] $CellContext`\[Gamma]10 $CellContext`v[
       4, 1][$CellContext`t] + 
