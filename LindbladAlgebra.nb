Cell[TextData[{
 "The Hamiltonian vector is obtained by projecting the Hamiltonian on the \
elements of the set ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[GothicH]",
     FontWeight->"Bold"], "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "203f696a-6312-4a63-8e5b-f130e61b809a"],
 " through Eq. (21)."
}], "Text",
