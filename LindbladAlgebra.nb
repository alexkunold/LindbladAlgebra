 RowBox[{
  RowBox[{
   RowBox[{"XBasisFromQubits", "[", "nq_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", "c"}], "}"}], "=", 
       RowBox[{"BCStructureConstantsFromQubits", "[", "nq", "]"}]}], ";", 
