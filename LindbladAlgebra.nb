Cell[TextData[{
 "The Hamiltonian vector is obtained by projecting the Hamiltonian on the \
elements of the set ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[GothicH]",
     FontWeight->"Bold"], "n"], TraditionalForm]],ExpressionUUID->
  "b6f3af88-8116-42a1-b872-837e964105a5"],
