Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NQubitBasis", "[", "nq_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h0", ",", "h1", ",", "sq2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sq2", "=", 
       RowBox[{"1", "/", 
        SqrtBox["2.0"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"h0", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", "sq2"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "2"}], "}"}], "\[Rule]", "sq2"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "1", ",", "2"}], "}"}], "\[Rule]", "sq2"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", "1"}], "}"}], "\[Rule]", "sq2"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "1", ",", "2"}], "}"}], "\[Rule]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "sq2"}]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "2", ",", "1"}], "}"}], "\[Rule]", 
           RowBox[{"\[ImaginaryI]", " ", "sq2"}]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"4", ",", "1", ",", "1"}], "}"}], "\[Rule]", "sq2"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"4", ",", "2", ",", "2"}], "}"}], "\[Rule]", 
           RowBox[{"-", "sq2"}]}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"h1", "=", "h0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"h1", "=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"h1", ",", "h0"}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", 
          RowBox[{"nq", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "h1"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QubitBasis", "[", "nq_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h0", ",", "h1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h0", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
           FractionBox["1", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "2"}], "}"}], "\[Rule]", 
