               RowBox[{"\[ImaginaryI]", " ", "H"}], "-", 
               RowBox[{
                FractionBox["1", "4"], "trGZ"}]}], ")"}]}], "]"}], "+", 
           RowBox[{"-", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[ImaginaryI]", " ", "H"}], "+", 
                RowBox[{
                 FractionBox["1", "4"], "trGZ"}]}], ")"}], ",", 
              RowBox[{"SparseArray", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", "\[Rule]", "1"}], "}"}], ",", "n"}], "]"}]}], 
             "]"}]}]}], ")"}]}]}], ")"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
