11b5fdb37647"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"J1", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", "n", ",", 
          RowBox[{"n", "+", "1"}]}], "}"}], "->", 
        RowBox[{
         SqrtBox["n"], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Alpha]", " ", "n", " ", 
           "t"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "-", "1"}], ",", "m", ",", "m"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J1t", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"n", "+", "1"}], ",", "n"}], "}"}], "->", 
        RowBox[{
         SqrtBox["n"], 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Alpha]", " ", "n", " ", "t"}], 
          "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "-", "1"}], ",", "m", ",", "m"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
