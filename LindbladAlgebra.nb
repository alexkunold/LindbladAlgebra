 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0.9999998678385302`", "0", "0", "0"},
     {"0", "0.9980109401820338`", "0", 
      RowBox[{"-", "0.027905521498452938`"}]},
     {
      RowBox[{"-", "0.00028068276644516095`"}], "0", 
