        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
           FractionBox["1", 
            SqrtBox["2"]]}], ",", 
          RowBox[{
           RowBox[{"{", 
