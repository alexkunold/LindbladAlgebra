 RowBox[{"\[CapitalLambda]", "=", 
  RowBox[{"LambdaFromHamiltonianLindbladian", "[", 
   RowBox[{"z", ",", "H", ",", "\[CapitalGamma]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "\[CapitalLambda]", "]"}]}], "Input",
