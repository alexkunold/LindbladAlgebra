      "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"commu", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"xx", "-", 
     RowBox[{"Transpose", "[", 
      RowBox[{"xx", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "1", ",", "2", ",", "5", ",", "6"}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
