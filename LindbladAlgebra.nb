Cell[CellGroupData[{

Cell["Liouville equation for the dynamical map", "Subsection",
 CellChangeTimes->{{3.990811117238882*^9, 
  3.990811127679689*^9}},ExpressionUUID->"16f5351a-1a72-4f79-a639-\
5023c82f3d12"],

Cell[TextData[{
 "To verify that the dynamical differential equations for the coordinate \
vector, Eq. (97), are equivalent to those derived from the Lindbladian, we \
directly project the Liouville operator acting on the dynamical map, as given \
on the right-hand side of Eq. (94), onto the basis ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". We then subtract the resulting expression from the right-hand side of Eq. \
(97), which should yield zero if both formulations are equivalent. First, we \
define the elements of the dynamical map as in Eq. (92)."
}], "Text",
 CellChangeTimes->{{3.9912148213661957`*^9, 3.991214907524946*^9}, {
   3.991215106411063*^9, 3.9912151636500387`*^9}, {3.991215334512278*^9, 
   3.991215363152875*^9}, {3.991215395263175*^9, 3.9912154387509947`*^9}, {
   3.9912155216302967`*^9, 3.9912156688579903`*^9}, 
   3.991215770303673*^9},ExpressionUUID->"bf4bffdf-c2cc-4808-ae0f-\
2fa184d47032"],

Cell[BoxData[
 RowBox[{
  RowBox[{"V", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"Array", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", "##", "]"}], "[", "t", "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.990816836988379*^9, 3.990816879196498*^9}, {
  3.990817063790866*^9, 3.9908170689201393`*^9}, {3.990817388048842*^9, 
  3.990817392459559*^9}, {3.990817425684067*^9, 3.990817447870356*^9}, {
  3.9908174913571568`*^9, 3.99081749417586*^9}, {3.990818896261354*^9, 
  3.9908189889050293`*^9}, {3.990820025899489*^9, 3.990820061711212*^9}, {
  3.990820128788583*^9, 3.9908201382405252`*^9}, {3.991211711714367*^9, 
  3.9912117122740183`*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"50f222b2-7c70-48e2-a7dc-ab54a4d343be"],

Cell["\<\
We calculate the right-hand side of the dynamical differential equations \
using the algebraically derived Eq. (97).\
\>", "Text",
 CellChangeTimes->{{3.9912158389325027`*^9, 3.991215920298376*^9}, 
   3.991215950482933*^9},ExpressionUUID->"ae5f4cca-2772-4f3a-b1dc-\
2f2db9dc657b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiffEqsAlgebraicMethod", "=", 
  RowBox[{"SparseArray", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", "V", "]"}], ".", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{
          FractionBox["1", "4"], 
          RowBox[{"zt", ".", "\[CapitalLambda]", ".", "z"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
      "1"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.990816268840473*^9, 3.990816294244981*^9}, {
