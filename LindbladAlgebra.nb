 RowBox[{
  RowBox[{"zz", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"z", ".", 
      RowBox[{"Transpose", "[", "z", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"commu", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"zz", "-", 
     RowBox[{"Transpose", "[", "zz", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"PossibleZeroQ", "[", 
  RowBox[{"SparseArray", "[", 
   RowBox[{"commu", "+", 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"c", ".", "z"}]}]}], "]"}], "]"}]}], "Input",
