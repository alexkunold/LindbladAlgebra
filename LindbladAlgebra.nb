 RowBox[{
  RowBox[{"nq", "=", "1"}], ";"}]], "Input",
 CellChangeTimes->{{3.9908109548837233`*^9, 3.990810954984765*^9}, {
  3.990811021062748*^9, 3.990811021225751*^9}, {3.990817802534995*^9, 
  3.9908178032060747`*^9}, {3.990818619843708*^9, 3.990818629957793*^9}, {
