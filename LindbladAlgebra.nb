 RowBox[{
  RowBox[{"xx", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"x", ".", 
      RowBox[{"Transpose", "[", 
       RowBox[{"x", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "5", ",", "3", ",", "4", ",", "6"}], 
      "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"commu", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"xx", "-", 
     RowBox[{"Transpose", "[", 
      RowBox[{"xx", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "1", ",", "2", ",", "5", ",", "6"}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"anticommu", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"xx", "+", 
