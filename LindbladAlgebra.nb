      RowBox[{"xx", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "1", ",", "2", ",", "5", ",", "6"}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"anticommu", "=", 
   RowBox[{"SparseArray", "[", 
