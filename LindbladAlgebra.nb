Cell[TextData[{
 "We can also get a notion of the magnitude of the leakages of probability by \
plotting the density matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", 
    RowBox[{"3", ",", "3"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dcd69f2c-95e5-4dcd-aae1-710b158d48bc"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", 
    RowBox[{"4", ",", "4"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95b65088-b27d-45d8-9f72-e34dea85f1d6"]
}], "Text",
 CellChangeTimes->{{3.999628474586671*^9, 
  3.9996286329827137`*^9}},ExpressionUUID->"ba17cf88-c717-436a-b490-\
5e884bf20456"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"rho", "[", 
       RowBox[{"[", 
        RowBox[{"3", ",", "3"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<t (ns)\>\"", ",", "20"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\[Rho](t)\>\"", ",", "Italic", ",", "20"}], "]"}]}], 
       "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
