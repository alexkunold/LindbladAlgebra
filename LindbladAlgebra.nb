Cell[TextData[{
 "The Lie and Jordan algebraic relations of ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " can be verified by evaluating the following differences, obtained by \
subtracting the right-hand side from the left-hand side of Eqs. (81) and \
(82), and verifying that they vanish identically.  This calculation may \
exceed the available memory if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "q"], TraditionalForm]],ExpressionUUID->
  "e814019b-6c2e-4a96-9111-9781105e5358"],
 "\[GreaterSlantEqual]2."
}], "Text",
