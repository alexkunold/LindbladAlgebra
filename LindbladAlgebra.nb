  3.9996314319649887`*^9, 3.9996315236620073`*^9, {3.999631597746565*^9, 
   3.999631648129437*^9}, 3.9996317251310463`*^9, 3.9996317616901703`*^9, 
   3.999632241470883*^9, 3.999632283018959*^9, 3.999632323577675*^9, {
   3.99963413258366*^9, 3.999634147605147*^9}, 3.999634211938691*^9, {
   3.9996342579101343`*^9, 3.999634283072989*^9}, {3.999634557112591*^9, 
   3.99963456607327*^9}, 3.9996890712167883`*^9, {3.999691505166231*^9, 
   3.999691517648054*^9}, 4.000051901695072*^9, {4.000053896052981*^9, 
   4.000053901075923*^9}, 4.0001276615298967`*^9, 4.0001276929659367`*^9, 
   4.0013570339815483`*^9, 4.00158221490917*^9},
 CellLabel->
