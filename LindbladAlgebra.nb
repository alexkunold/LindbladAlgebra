Cell[TextData[{
 "It can be verified that ",
 StyleBox["Z",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " and",
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Z",
     FontWeight->"Bold"], "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dbe8343e-a208-4348-b6de-9273f1f146ab"],
 " constitute to independent realizations of the Lie algebra associated with \
h by showing that the following difference, obtained by subtracting the \
right-hand side from the left-hand side of Eqs. (65) and (66), vanish \
identically."
}], "Text",
 CellChangeTimes->{{3.990789543657935*^9, 3.990789682346746*^9}, {
