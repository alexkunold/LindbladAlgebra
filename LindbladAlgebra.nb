Cell[TextData[{
 "The preceding results suggest behavior consistent with an X gate. To assess \
how closely the evolution approximates this gate, we compute the dynamical \
map projected onto the computational subspace spanned by the two lowest \
energy levels, \[LeftBracketingBar]0\[RightAngleBracket] and \
\[LeftBracketingBar]1\[RightAngleBracket]. We start by computing the \
dynamical mat in the Liouville space and evaluate it at ",
 StyleBox["t ",
  FontSlant->"Italic"],
 "= tmax."
}], "Text",
 CellChangeTimes->{{3.9996908027965393`*^9, 3.9996909629208927`*^9}, {
  3.999690996356319*^9, 3.9996910118063507`*^9}, {3.999691057998535*^9, 
  3.9996911678191433`*^9}},ExpressionUUID->"93cc37b4-31c1-431d-a984-\
448fab8555aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Vmat", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"fV", ".", "X"}], "]"}], "/.", "sol"}], "/.", 
    RowBox[{"{", 
     RowBox[{"t", "\[Rule]", "tmax"}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999631095284745*^9, 3.999631179685955*^9}, {
  3.999631241579473*^9, 3.9996312601346893`*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"172a0eb7-69cf-4ae0-864f-71a28f179a89"],

Cell[TextData[{
 "To obtain the dynamical map on the computational subspace spanned by the \
two lowest energy levels, \[LeftBracketingBar]0\[RightAngleBracket] and \
\[LeftBracketingBar]1\[RightAngleBracket] we construct a one-qubit operator \
basis, embed it in the four-level operator space, and project ",
 StyleBox["V(t)",
  FontSlant->"Italic"],
 " onto it. "
}], "Text",
 CellChangeTimes->{{3.999691186629388*^9, 3.999691247620019*^9}, {
  3.999691354981681*^9, 
  3.9996913733599977`*^9}},ExpressionUUID->"63bb7919-ea73-42df-8f64-\
483f2936df7c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g0", "=", 
   RowBox[{"QubitBasis", "[", "1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", "g0"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"g", ".", 
      RowBox[{"Transpose", "[", "h", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"Chop", "[", 
   RowBox[{
    RowBox[{"T", ".", "Vmat", ".", 
     RowBox[{"Transpose", "[", "T", "]"}]}], ",", 
    RowBox[{"1", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9996314100008*^9, 3.99963164718113*^9}, {
  3.999631717474358*^9, 3.999631722109192*^9}, {3.999631759147687*^9, 
  3.9996317609603*^9}, {3.999632238941625*^9, 3.999632312513822*^9}, {
  3.999634032753751*^9, 3.9996340937779512`*^9}, {3.9996341307238503`*^9, 
  3.999634282257999*^9}, {3.9996345490745087`*^9, 3.999634565378861*^9}, {
  3.999691504169073*^9, 3.999691516978816*^9}, {4.00012768159137*^9, 
  4.000127691653433*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"b4d3b866-f9f6-4dc5-9655-0d6f7e62b4f6"],

