 RowBox[{
  RowBox[{"xx", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"x", ".", 
      RowBox[{"Transpose", "[", 
       RowBox[{"x", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
