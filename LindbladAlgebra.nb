 CellLabel->"In[78]:=",ExpressionUUID->"50f222b2-7c70-48e2-a7dc-ab54a4d343be"],

Cell["\<\
We calculate the right-hand side of the dynamical differential equations \
using the algebraically derived Eq. (112).\
\>", "Text",
 CellChangeTimes->{{3.9912158389325027`*^9, 3.991215920298376*^9}, 
   3.991215950482933*^9, {4.0000670760773478`*^9, 
   4.0000670769215593`*^9}},ExpressionUUID->"ae5f4cca-2772-4f3a-b1dc-\
2f2db9dc657b"],

