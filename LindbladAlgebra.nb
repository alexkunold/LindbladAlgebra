Cell[BoxData[
 RowBox[{"DiffEqsDirectMethod", "=", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Transpose", "[", "V", "]"}], ".", 
     RowBox[{"TensorContract", "[", 
      RowBox[{
       RowBox[{"x", ".", 
        RowBox[{"Transpose", "[", 
         RowBox[{"x", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], "]"}], ".", 
        "Ldm"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "]"}]}]], "Input",
