Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]", " ", "=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[CapitalDelta]", " ", "t"}], " ", "+", "\[Phi]"}], ")"}]}], 
     "]"}], 
    RowBox[{"Map", "[", 
     RowBox[{"Exp", ",", 
      RowBox[{"\[ImaginaryI]", " ", "\[Alpha]", " ", "t", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Range", "[", 
          RowBox[{"m", "-", "1"}], "]"}]}], ")"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]t", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[CapitalDelta]", " ", "t"}], " ", "+", "\[Phi]"}], ")"}]}], 
     "]"}], 
    RowBox[{"Map", "[", 
     RowBox[{"Exp", ",", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Alpha]", " ", "t", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Range", "[", 
          RowBox[{"m", "-", "1"}], "]"}]}], ")"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hi", "=", 
   RowBox[{
    FractionBox["\[CapitalOmega]", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Psi]", ".", "A"}], "+", 
      RowBox[{"\[Psi]t", ".", "At"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "Hi", "]"}], "\[IndentingNewLine]"}], "Input",
