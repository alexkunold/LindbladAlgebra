Cell[CellGroupData[{

Cell[TextData[{
 "Example 2. Two-level transmon dynamics: ",
 StyleBox["X",
  FontSlant->"Italic"],
 "-gate implementation and leakage"
}], "Section",
 CellChangeTimes->{{3.999689863886607*^9, 3.999689880656539*^9}, {
  3.9996901382440367`*^9, 3.999690145706326*^9}, {3.9996907319596643`*^9, 
  3.99969073714193*^9}, {4.001791311790662*^9, 4.001791311864859*^9}, {
  4.0017913589800043`*^9, 
  4.001791366254736*^9}},ExpressionUUID->"9a4aaf74-8117-4998-a670-\
c496d4af0972"],

Cell[CellGroupData[{

Cell["Numerical solution of the differential equation", "Subsection",
 CellChangeTimes->{{4.001863878965724*^9, 
  4.00186389737737*^9}},ExpressionUUID->"8dd66c76-7a00-4ed9-b055-\
3bf29a5b4280"],

Cell[TextData[{
 "To illustrate how to solve the resulting system of ordinary differential \
equations, we study the dynamics of a transmon truncated to its four lowest \
energy levels, using a pulse designed to implement an ",
 StyleBox["X",
  FontSlant->"Italic"],
 " (",
 StyleBox["NOT",
  FontSlant->"Italic"],
 ") gate. This allows us to examine population leakage from the computational \
subspace, spanned by \[LeftBracketingBar]0\[RightAngleBracket] and \
\[LeftBracketingBar]1\[RightAngleBracket], into the higher levels\
\[LeftBracketingBar]2\[RightAngleBracket] and \[LeftBracketingBar]3\
\[RightAngleBracket] during the gate operation. ",
 "For this purpose we use the differential equations derived in the previous \
example (stored in the variable DiffEqsAlgebraicMethod). ",
 "We flatten the time derivative of the dynamical map ",
 StyleBox["V(t)",
  FontSlant->"Italic"],
 " and equate it to the flattened right-hand side obtained above. This \
process yields the equations in the format required by NDSolve."
}], "Text",
 CellChangeTimes->{{3.999605232566019*^9, 3.999605337924259*^9}, {
   3.999605415020452*^9, 3.999605430875017*^9}, {3.999618292645598*^9, 
   3.999618337249332*^9}, 3.999618377179701*^9, {3.9996893157418747`*^9, 
   3.999689394013516*^9}, 3.999689564355731*^9, 3.999690180184156*^9, 
   3.9996902240359507`*^9, {3.9996902685865097`*^9, 3.9996903825561657`*^9}, {
   3.99969047735603*^9, 3.999690498521556*^9}, {3.999690583422845*^9, 
   3.9996906567876368`*^9}, {3.999690704487365*^9, 
   3.999690720237067*^9}},ExpressionUUID->"c9922129-2e83-468b-a89f-\
e2289b765a9f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fV", "=", 
   RowBox[{"Flatten", "[", "V", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"fV", ",", "t"}], "]"}], "==", 
     RowBox[{"Flatten", "[", "DiffEqsAlgebraicMethod", "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.999532458544079*^9, 3.999532495429757*^9}, {
  3.999532527289*^9, 3.999532628926279*^9}, {3.999535782103916*^9, 
  3.9995357825689774`*^9}, {3.999539207168619*^9, 3.999539209600885*^9}, {
  3.999539457527329*^9, 3.999539464155905*^9}, {3.999593459608406*^9, 
  3.999593460144261*^9}, {4.001791615986683*^9, 4.001791634660756*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"690b6155-b579-4387-a6ad-aec15372e446"],

Cell[TextData[{
 "We choose parameter values typical of transmon qubits: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "0"], TraditionalForm]],ExpressionUUID->
  "6b2e829c-7fe5-407a-a388-019dfa0e283f"],
 "/2\[Pi]  = 50MHz, \[Alpha] /2\[Pi]  = -300MHz, \[Omega]/2\[Pi] = 3 GHz, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]],ExpressionUUID->
  "508dc6c0-896e-440e-986d-0aac4d97a12d"],
 "  = 150 \[Mu]s and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "2"], TraditionalForm]],ExpressionUUID->
  "493444d6-fa66-4b91-9291-fd2bf4ff5a36"],
 "= 100 \[Mu]s. "
}], "Text",
 CellChangeTimes->{{3.999532762665064*^9, 3.999532817789515*^9}, {
   3.999532850906506*^9, 3.999532862960321*^9}, {3.99953291966866*^9, 
   3.9995329337983007`*^9}, {3.99953308060126*^9, 3.999533155348014*^9}, {
   3.999618456769252*^9, 3.9996185761110086`*^9}, 3.999626744118207*^9, 
   3.999975865929851*^9},ExpressionUUID->"7f79174c-18b8-48e4-8754-\
75adce53b130"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]0", " ", "=", " ", 
   RowBox[{"2", "\[Pi]", " ", "0.05"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]0", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], "\[Pi]", " ", "0.3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]0", " ", "=", " ", 
   RowBox[{"2", "\[Pi]", " ", "3.0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"150.0", " ", 
    SuperscriptBox["10", "3"]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T2", "=", 
   RowBox[{"100.0", " ", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]10", "=", 
   RowBox[{"2", "/", "T1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]20", "=", 
   RowBox[{
    FractionBox["4", "T2"], "-", 
    FractionBox["2", 
     RowBox[{" ", "T1"}]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9995327344402733`*^9, 3.999532747183301*^9}, {
   3.9995329416731052`*^9, 3.999533068404181*^9}, {3.999533175864698*^9, 
   3.999533225679369*^9}, {3.999533295511859*^9, 3.999533367545087*^9}, {
   3.999534072214858*^9, 3.999534075815029*^9}, {3.99953546300068*^9, 
   3.9995354952665873`*^9}, {3.999535536831892*^9, 3.999535539472929*^9}, {
   3.9995356380094433`*^9, 3.999535640410179*^9}, {3.9995392230534143`*^9, 
   3.999539223516808*^9}, {3.999539872397574*^9, 3.99953987272845*^9}, 
   3.999539934691593*^9, {3.9996185976517763`*^9, 3.9996186136382303`*^9}, {
   3.999978785971506*^9, 3.9999787860762253`*^9}, {4.000053753804624*^9, 
   4.000053761079018*^9}, {4.000054363495017*^9, 4.0000543674996157`*^9}, {
   4.001773040369226*^9, 4.0017730783769283`*^9}, {4.0017732055893087`*^9, 
   4.001773214798194*^9}, {4.001858032736895*^9, 4.0018580433760653`*^9}, {
   4.0018581500802*^9, 4.0018581553570004`*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"8225d2e0-90ad-4dee-9c14-699ffbfe289a"],

Cell[TextData[{
 "Additionally, to facilitate comparison with known results, we use a \
Gaussian pulse with width \[Sigma] = 2\[Pi]/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "0"], TraditionalForm]],ExpressionUUID->
  "3f12198b-d7e4-4b38-9146-a03f749a375f"],
 " and choose the phase \[Phi] to implement an X gate. We then construct the \
system of equations, stored in eqsn, using these parameter values."
}], "Text",
 CellChangeTimes->{
  3.999618585020214*^9, {3.999618626567787*^9, 3.999618680747113*^9}, {
   3.999619239309305*^9, 3.999619298799542*^9}, {3.999626917284182*^9, 
   3.9996269700740557`*^9}, {3.9996276678918247`*^9, 3.999627724305409*^9}, 
   3.9996277642422733`*^9},ExpressionUUID->"2e4d6c9a-7a78-45c0-be0e-\
b6b613b7f63d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]", " ", "=", " ", 
   RowBox[{"2", 
    RowBox[{"\[Pi]", "/", "\[CapitalOmega]0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"4", "\[Sigma]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmin", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", 
   RowBox[{"8", "\[Sigma]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]0", " ", "=", " ", "0.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]0", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"constants", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "\[Rule]", "\[Alpha]0"}], ",", 
     RowBox[{"\[CapitalDelta]", "\[Rule]", "\[CapitalDelta]0"}], ",", 
     RowBox[{"\[CapitalOmega]", "\[Rule]", 
      RowBox[{
       FractionBox["\[CapitalOmega]0", 
        RowBox[{"2", 
         SqrtBox[
          RowBox[{"2", "\[Pi]"}]]}]], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"t", "-", "t0"}], "\[Sigma]"], ")"}], "2"]}], "]"}]}]}], ",", 
     RowBox[{"\[Phi]", "\[Rule]", "\[Phi]0"}], ",", 
     RowBox[{"\[Gamma]10", "\[Rule]", "\[CapitalGamma]10"}], ",", 
     RowBox[{"\[Gamma]20", "\[Rule]", "\[CapitalGamma]20"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqsn", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"eqs", "/.", "constants"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.999618616847994*^9, 3.9996186173576097`*^9}, {
  3.9996192275795517`*^9, 3.999619227729404*^9}, {3.999626990548923*^9, 
  3.9996269911821203`*^9}, {3.999627654510985*^9, 3.9996276549944563`*^9}, {
  4.000051880470705*^9, 4.000051880860458*^9}, {4.0000543824405746`*^9, 
  4.000054397065209*^9}, {4.000127566626107*^9, 4.000127601202795*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"f945203d-c20f-431a-bd9d-bf4f95973422"],

Cell[TextData[{
 "We impose the initial condition ",
 StyleBox["V(0)=I",
  FontSlant->"Italic"],
 " . In terms of the expansion coefficients, this corresponds to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", 
     RowBox[{"i", ",", "j"}]], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "d8d726aa-fdb9-4cc3-9a3c-cf1ec11190fe"],
 " for ",
 StyleBox["(i,j) \[NotEqual] (1,1) ",
  FontSlant->"Italic"],
 "and",
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "c2b1efd7-b72d-4f81-8238-6dad203b3b7c"],
 "= 4, since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "21f4df6f-3282-4bbb-896e-83208f48a2da"],
 "=I/4 for nq=2"
}], "Text",
 CellChangeTimes->{{3.999627125079327*^9, 3.999627361658206*^9}, {
  3.9996274258346853`*^9, 3.999627545599971*^9}, {3.999627576919722*^9, 
  3.999627637382401*^9}},ExpressionUUID->"6f02de04-6bd1-4d3f-94ec-\
4951979f6a9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"initialcond", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Normal", "[", "fV", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "0"}], "}"}]}], ")"}], "==", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "1", "}"}], "->", "2"}], ",", 
       SuperscriptBox["n", "2"]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9995932111740103`*^9, 3.99959333677864*^9}, {
   3.999593372594174*^9, 3.999593413385425*^9}, {3.999593474416644*^9, 
   3.99959349891963*^9}, {3.999594161923621*^9, 3.999594165747383*^9}, {
   3.999626988001234*^9, 3.9996269988141203`*^9}, 3.999627652067842*^9, 
   3.999627782804461*^9, {4.001791729370623*^9, 4.001791729456637*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"4470b21a-7aa9-467e-adfa-2a6b4a1ce90b"],

Cell["\<\
We combine the differential equations with the initial conditions and solve \
the resulting initial-value problem using NDSolve.\
\>", "Text",
 CellChangeTimes->{
  3.9996280704038343`*^9},ExpressionUUID->"abc301c6-f987-4427-9be1-\
014963abf949"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"diffeqsn", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"eqsn", ",", "initialcond"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"diffeqsn", ",", 
      RowBox[{"Normal", "[", "fV", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000127779514504*^9, 4.000127779916717*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"a399bb60-2780-47be-adb4-48b9a65af62c"],

Cell[TextData[{
 "To obtain a particular case, we can set the transmon to be initially in the \
first state. Then, the density matrix can be expanded through Eq. (16) and \
the actual density matrix is recovered as expanding it in terms of the basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicH]", "n"], TraditionalForm]],ExpressionUUID->
  "84367a97-4ba5-4579-90ef-54abdafb0c2c"],
 ". We first try the case where the lowest level is fully populated and the \
remaining ones are empty"
}], "Text",
 CellChangeTimes->{{3.9996281663140593`*^9, 3.999628347794333*^9}, {
  3.999689053069024*^9, 3.9996890595344057`*^9}, {4.000049582113708*^9, 
  4.000049621294445*^9}, {4.000067511831787*^9, 
  4.000067514035564*^9}},ExpressionUUID->"7b6d034d-e9bd-4302-b93e-\
60a79e452a5f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]0", "=", 
   RowBox[{"ProjectOperatorOntoBasis", "[", 
    RowBox[{
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", "h"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"fV", ".", "X", ".", "\[Rho]0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"\[Rho]", ".", "h"}], "]"}], "/.", "sol"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99953965127092*^9, 3.999539664991404*^9}, {
   3.9995397195451727`*^9, 3.99953972383955*^9}, {3.999539827531417*^9, 
   3.99953983869412*^9}, {3.999594397162304*^9, 3.999594434633309*^9}, 
   3.999628154329961*^9, {3.999689130503162*^9, 3.9996891352120667`*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"3ff1d9ad-079f-45c2-9ebd-f46726ff8894"],

Cell[TextData[{
 "Plotting the populations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     RowBox[{"1", ",", "1"}]], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"7e7d93fa-7ff4-463c-98f6-9874897c6bef"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     RowBox[{"2", ",", "2"}]], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"f617c45a-9d95-4eb1-af3f-346b066ff0f6"],
 " of the two first quantum levels of the transmon as a function of time"
}], "Text",
 CellChangeTimes->{{3.999689190983568*^9, 3.999689245165266*^9}, {
  3.999689291606373*^9, 3.999689295071362*^9}, {4.000049691451256*^9, 
  4.00004969688056*^9}},ExpressionUUID->"1a4152dc-4f9d-48cc-b16e-\
3e993a7e9173"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"rho", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Re", "[", 
        RowBox[{"rho", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<t (ns)\>\"", ",", "20"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\[Rho](t)\>\"", ",", "Italic", ",", "20"}], "]"}]}], 
       "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(1, 1\)]\)(t)\>\"", ",",
           "20"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"135", ",", "0.9"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(0, 0\)]\)(t)\>\"", ",",
           "20"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"135", ",", "0.1"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<(a)\>\"", ",", "25"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "0.9"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
     "}"}], "]"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.999539784722199*^9, 3.999539802691272*^9}, {
  3.999539909640592*^9, 3.9995399229612017`*^9}, {3.9995942658657293`*^9, 
