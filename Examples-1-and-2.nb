   3.991216237335052*^9, 3.991216249310935*^9}, {3.991216702140415*^9, 
   3.991216713263289*^9}, 3.99121742131448*^9, 3.9912175265691357`*^9, 
   3.991217627854466*^9, 3.991220745919648*^9, 3.994154646404665*^9, 
   3.994159779604951*^9, 3.9991104206607533`*^9, 3.999112108395317*^9, 
   3.999529697143467*^9, 4.000053161667037*^9, 4.000053378459565*^9, 
   4.000124318584887*^9, 4.0001281370909567`*^9, 4.001339177819668*^9, 
