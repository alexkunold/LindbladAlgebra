Cell[CellGroupData[{

Cell["Lindbladian", "Subsection",
 CellChangeTimes->{{3.9900977777960367`*^9, 
  3.990097780139242*^9}},ExpressionUUID->"d7a28b2f-e1d4-4125-a33f-\
425aaa0b2627"],

Cell[TextData[{
 "To construct the Lindbladian, we first introduce the corresponding jump \
operators. In the case of transmons, two decoherence processes are \
particularly relevant: energy relaxation and pure dephasing. Energy \
relaxation describes the loss of an excitation from the transmon to its \
environment and is represented by the Lindblad jump operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "1"], "=", "a"}], TraditionalForm]],ExpressionUUID->
  "52d64034-e1b6-4287-a116-c2a6a21bd63f"],
 ". This process is characterized by the relaxation time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]],ExpressionUUID->
  "1614a319-f884-4ac2-aa39-a5a25a5f66ef"],
 ", time or equivalently by the relaxation rate  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", "1"], "=", 
    RowBox[{"1", "/", 
     SubscriptBox["T", "1"]}]}], TraditionalForm]],ExpressionUUID->
  "c9583134-d64e-461d-b770-dab141997c37"],
 ".  Although the corresponding contribution to the Lindbladian is time \
independent in the Schr\[ODoubleDot]dinger picture, it becomes time dependent \
in the interaction picture used here to express the Hamiltonian. For a \
harmonic oscillator a simple scalar phase cancels completely, but for the \
anharmonic transmon the phase contains the number operator n=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "\[Dagger]"], "a"}], TraditionalForm]],ExpressionUUID->
  "8867eb61-28bb-4940-b1c1-350376bae23d"],
 ", that introduces the time dependency. This time dependency is easily \
introduced through the phases and decomposing into transition operators the \
lowering and rising operators"
}], "Text",
 CellChangeTimes->{{3.9994401698599358`*^9, 3.999440207179998*^9}, {
  3.9994403388670673`*^9, 3.999440350072646*^9}, {3.999440517429809*^9, 
  3.999440776082013*^9}, {3.999440816432489*^9, 3.999441005531597*^9}, {
  3.999441068723939*^9, 3.9994410754192038`*^9}, {3.9994411433123827`*^9, 
  3.999441247852512*^9}, {3.9994413698823643`*^9, 3.999441377907337*^9}, {
  3.999441446520035*^9, 3.999441467819911*^9}, {3.999441570260825*^9, 
  3.999441690192367*^9}, {3.9995275891786833`*^9, 
  3.999527589554995*^9}},ExpressionUUID->"e01b76b2-4125-41fa-b602-\
c71ad471f7d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"J1", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", "n", ",", 
          RowBox[{"n", "+", "1"}]}], "}"}], "->", 
        RowBox[{
         SqrtBox["n"], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Alpha]", " ", "n", " ", 
           "t"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "-", "1"}], ",", "m", ",", "m"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J1t", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"n", "+", "1"}], ",", "n"}], "}"}], "->", 
        RowBox[{
         SqrtBox["n"], 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Alpha]", " ", "n", " ", "t"}], 
          "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "-", "1"}], ",", "m", ",", "m"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.999527549055194*^9, 3.999527573068797*^9}, 
