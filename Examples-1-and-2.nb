Cell[CellGroupData[{

Cell["\<\
Verification of dynamical map properties using the unnormalized Choi matrix\
\>", "Subsection",
 CellChangeTimes->{{4.0018639564417477`*^9, 4.001863971179863*^9}, {
  4.001864043755858*^9, 
  4.0018640545685883`*^9}},ExpressionUUID->"27ae9c66-7d67-41b7-a131-\
360e8dda38c9"],

Cell[TextData[{
 "To verify Hermiticity preservation, complete positivity, and trace \
preservation of the dynamical map, we construct its unnormalized Choi matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "t"], TraditionalForm]],ExpressionUUID->
  "9e4a6e61-c4a4-432d-8abd-86f37b4208ae"],
 " using Eq. (114) and check the corresponding conditions."
}], "Text",
 CellChangeTimes->{{4.001792199269443*^9, 4.001792204264377*^9}, {
   4.0017922829850817`*^9, 4.001792424105589*^9}, 4.0017925159831543`*^9, {
   4.0017931279166927`*^9, 4.0017931284186277`*^9}, {4.001862159125009*^9, 
   4.001862159587557*^9}},ExpressionUUID->"0c742582-4fd7-4aae-8bae-\
4c07f3004f87"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}], ",", 
       RowBox[{"{", "1", "}"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jt", "=", 
   RowBox[{"B", ".", 
    RowBox[{"Transpose", "[", "V", "]"}], ".", 
    RowBox[{"ConjugateTranspose", "[", "B", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.001790341949233*^9, 4.001790412164679*^9}, 
   4.001860344950959*^9},
 CellLabel->
  "In[124]:=",ExpressionUUID->"4a8056b8-f3ac-4de6-8cd9-11e22a66cad1"],

Cell["\<\
To check the three conditions, we evaluate the unnormalized Choi operator at \
a selected time between tmin and tmax\
\>", "Text",
 CellChangeTimes->{{4.001792543624241*^9, 4.001792550794004*^9}, {
  4.001792583149963*^9, 4.001792605306621*^9}, {4.0017926389336653`*^9, 
  4.0017926637584753`*^9}, {4.001792922019947*^9, 
  4.0017929302943497`*^9}},ExpressionUUID->"8da9bab7-0c6a-49d4-9f69-\
81b17b0c37b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Jtn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", "Jt", "]"}], "/.", "sol"}], "/.", 
    RowBox[{"{", 
     RowBox[{"t", "\[Rule]", 
      RowBox[{"tmin", "+", 
       RowBox[{"0.8", 
        RowBox[{"(", 
         RowBox[{"tmax", "-", "tmin"}], ")"}]}]}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.001790057890126*^9, 4.0017900651499968`*^9}, {
   4.001790309969324*^9, 4.001790319359147*^9}, {4.001790420098915*^9, 
   4.001790461422275*^9}, {4.0017908528309917`*^9, 4.001790876786865*^9}, {
   4.001791284341037*^9, 4.001791284430398*^9}, 4.00179253376115*^9, {
   4.001858092186633*^9, 4.001858092746092*^9}},
 CellLabel->
  "In[126]:=",ExpressionUUID->"30f13620-6a9d-4e83-8e23-ed9e8b019efa"],

Cell[TextData[{
 "First, we check Hermiticity preservation by subtracting ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["J", "t", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "75205fb6-3c15-47a8-a679-3758e12d2a1f"],
 " from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "t"], TraditionalForm]],ExpressionUUID->
  "dc7aebf8-8cbd-49dc-b726-3111ba047bc1"]
}], "Text",
 CellChangeTimes->{{4.0017926708830233`*^9, 4.001792740319045*^9}, 
   4.0017929812398367`*^9, {4.001793081179998*^9, 
   4.001793106077218*^9}},ExpressionUUID->"a495ecf1-b6a1-4be0-956e-\
1cc790ce04a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Jtn", "-", 
     RowBox[{"ConjugateTranspose", "[", "Jtn", "]"}]}], "]"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0017904696897287`*^9, 4.0017905430247803`*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"9137af37-ef4f-49ed-aa58-e1a22f2dce3e"],

Cell[BoxData["1.1102230246251565`*^-16"], "Output",
 CellChangeTimes->{{4.001790495863183*^9, 4.0017905436600037`*^9}, {
   4.00179086066322*^9, 4.0017908875115337`*^9}, 4.001791288627152*^9, 
   4.001792035858144*^9, 4.001858097895606*^9, 4.001860497794512*^9, 
   4.001944503521531*^9, 4.001946327245681*^9, 4.001950071810327*^9, 
   4.001950217455097*^9, 4.0019504577046537`*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"f838f5d8-08f4-42af-8a62-422377a740d2"]
}, Open  ]],

Cell[TextData[{
 "This result shows that the maximum difference between the two operators is \
negligible. To verify complete positivity, we calculate the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "t"], TraditionalForm]],ExpressionUUID->
  "1a1de407-c2be-4a6c-9137-59c735ceeb9e"],
 " and check that they are nonnegative within numerical precision."
}], "Text",
 CellChangeTimes->{{4.001792763403911*^9, 4.001792870563311*^9}, {
  4.0017930327809687`*^9, 
  4.00179304549218*^9}},ExpressionUUID->"05bf773d-5df6-48a1-9e0e-\
d137a3d7e1f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"Eigenvalues", "[", "Jtn", "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.0017905867786827`*^9, 4.001790617244042*^9}, {
   4.0017907510718946`*^9, 4.0017907537715483`*^9}, {4.0017912406475983`*^9, 
   4.001791255888893*^9}, 4.001793144238908*^9},
 CellLabel->
  "In[128]:=",ExpressionUUID->"ce7f2951-1a25-4755-9c29-9b59b6f42a51"],

