Cell["\<\
We can also try other initial configurations, as one in which the second \
level is initially fully populated.\
\>", "Text",
 CellChangeTimes->{{3.99962875236187*^9, 
  3.999628798681159*^9}},ExpressionUUID->"de28dba2-6733-4088-a421-\
c09d94cee015"],

