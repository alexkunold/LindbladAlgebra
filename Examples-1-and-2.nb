Cell[TextData[{
 "Pure dephasing describes a phenomenon that does not change the energy-level \
populations but instead, destroys coherence between different energy \
eigenstates. It is characterized by the jump operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "2"], "=", 
    RowBox[{
     SuperscriptBox["a", "\[Dagger]"], "a"}]}], TraditionalForm]],
  ExpressionUUID->"40243b8e-deb7-4041-a960-2a709a126c79"]
}], "Text",
 CellChangeTimes->{{3.999528340899716*^9, 3.999528357849785*^9}, {
  3.999528464569586*^9, 3.999528640997245*^9}, {3.9995287025857687`*^9, 
  3.999528829572966*^9}},ExpressionUUID->"65e34097-dede-4af5-af86-\
0b1958616628"],

