Cell["\<\
An easy way to verify that there is trace preservation we plot the trace of \
the density matrix as a function of time\
\>", "Text",
 CellChangeTimes->{
  4.001794373591769*^9},ExpressionUUID->"dadec8f5-ad9f-4a75-a5ff-\
039dd669f0c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Tr", "[", "rho", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<t (ns)\>\"", ",", "20"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<tr[\[Rho](t)]\>\"", ",", "Italic", ",", "20"}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{4.001772741401189*^9, 4.001772837643255*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"04134f6b-0e94-4601-bfc9-64e6b650eaf6"],

