Cell[TextData[{
 "It can be verified that ",
 StyleBox["Z",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " and",
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Z",
     FontWeight->"Bold"], "*"], TraditionalForm]],ExpressionUUID->
  "dbe8343e-a208-4348-b6de-9273f1f146ab"],
 " constitute to independent realizations of the Lie algebra associated with \
h by showing that the following difference, obtained by subtracting the \
right-hand side from the left-hand side of Eqs. (70) and (71), vanish \
identically."
}], "Text",
 CellChangeTimes->{{3.990789543657935*^9, 3.990789682346746*^9}, {
  3.9907955738079557`*^9, 3.990795583990322*^9}, {3.990795799843486*^9, 
