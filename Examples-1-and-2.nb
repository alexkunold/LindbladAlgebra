 CellLabel->"In[87]:=",ExpressionUUID->"50f222b2-7c70-48e2-a7dc-ab54a4d343be"],

Cell["\<\
We calculate the right-hand side of the dynamical differential equations \
using the algebraically derived Eq. (113).\
\>", "Text",
 CellChangeTimes->{{3.9912158389325027`*^9, 3.991215920298376*^9}, 
   3.991215950482933*^9, {4.0000670760773478`*^9, 4.0000670769215593`*^9}, {
   4.0019452202984953`*^9, 
   4.001945220417378*^9}},ExpressionUUID->"ae5f4cca-2772-4f3a-b1dc-\
2f2db9dc657b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiffEqsAlgebraicMethod", "=", 
  RowBox[{"SparseArray", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", "V", "]"}], ".", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{
          FractionBox["1", "4"], 
          RowBox[{"zt", ".", "\[CapitalLambda]", ".", "z"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
      "1"}], "]"}]}], "]"}]}]], "Input",
