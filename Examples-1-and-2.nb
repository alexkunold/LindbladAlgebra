Cell[CellGroupData[{

Cell[TextData[{
 "Dynamical map of the ",
 StyleBox["X",
  FontSlant->"Italic"],
 " gate"
}], "Subsection",
 CellChangeTimes->{{4.001863928615122*^9, 4.001863937066815*^9}, {
  4.001945168638269*^9, 
  4.001945169044726*^9}},ExpressionUUID->"523894c3-9487-4fd1-999b-\
350d671f9a1a"],

Cell[TextData[{
 "The preceding results suggest behavior consistent with an X gate. To assess \
how closely the evolution approximates this gate, we compute the dynamical \
map projected onto the computational subspace spanned by the two lowest \
energy levels, \[LeftBracketingBar]0\[RightAngleBracket] and \
\[LeftBracketingBar]1\[RightAngleBracket]. We start by computing the \
dynamical mat in the Liouville space and evaluate it at ",
 StyleBox["t ",
  FontSlant->"Italic"],
 "= tmax."
}], "Text",
 CellChangeTimes->{{3.9996908027965393`*^9, 3.9996909629208927`*^9}, {
  3.999690996356319*^9, 3.9996910118063507`*^9}, {3.999691057998535*^9, 
  3.9996911678191433`*^9}},ExpressionUUID->"8b145751-56c1-41d9-9e51-\
86408a4230fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Vmat", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"fV", ".", "X"}], "]"}], "/.", "sol"}], "/.", 
    RowBox[{"{", 
     RowBox[{"t", "\[Rule]", "tmax"}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999631095284745*^9, 3.999631179685955*^9}, {
  3.999631241579473*^9, 3.9996312601346893`*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"2d84fe73-d46b-4ee8-9797-5030aae6e942"],

Cell[TextData[{
 "The dynamical map of the ",
 StyleBox["X",
  FontSlant->"Italic"],
 " gate takes the form"
}], "Text",
