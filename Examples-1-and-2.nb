  3.9908174913571568`*^9, 3.99081749417586*^9}, {3.990818896261354*^9, 
  3.9908189889050293`*^9}, {3.990820025899489*^9, 3.990820061711212*^9}, {
  3.990820128788583*^9, 3.9908201382405252`*^9}, {3.991211711714367*^9, 
