Cell[TextData[{
 "Here, we project the Liouville operator obtained through the direct method, \
acting on the dynamical map as given on the right-hand side of Eq. (110), \
onto the basis ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.991216002736809*^9, 3.991216074135544*^9}, 
