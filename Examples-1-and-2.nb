 RowBox[{"{", 
  RowBox[{
  "1.9982942670502883`", ",", "0.0008119813937309539`", ",", 
   "0.0005695955343366682`", ",", "0.00032415602164307305`"}], 
  "}"}]], "Output",
 CellChangeTimes->{{4.001790596008235*^9, 4.001790618200756*^9}, 
   4.001790754662562*^9, 4.001790901354636*^9, {4.001791243229472*^9, 
   4.001791256641425*^9}, 4.00179129221037*^9, 4.0017920412850657`*^9, 
   4.001793146869776*^9, 4.001858105910914*^9, 4.001860502321538*^9, 
   4.001946327273284*^9, 4.001950071835497*^9, 4.001950217462908*^9, 
   4.0019504577120543`*^9},
 CellLabel->
  "Out[128]=",ExpressionUUID->"8ba9e53d-68c1-45c2-9cb5-baf99e9b1bee"]
}, Open  ]],

Cell["Finally, we check trace preservation by taking the trace", "Text",
 CellChangeTimes->{{4.001793800558032*^9, 
  4.001793814689398*^9}},ExpressionUUID->"6a1aca8e-5192-4a5c-b68e-\
8c8a6695a1c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"h", ",", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", "1"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "2"}], "}"}], "\[Rule]", "1"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "2"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"Chop", "[", 
   RowBox[{
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"g", ".", "Jtn"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], "}"}]}], "]"}], ".", "h"}], "]"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.001793327385778*^9, 4.0017933297251167`*^9}, {
  4.001793466017818*^9, 4.001793484602097*^9}, {4.001793525865508*^9, 
  4.001793610089397*^9}, {4.0017936823165693`*^9, 4.001793737344499*^9}, {
  4.001794021183326*^9, 4.001794026249868*^9}, {4.001860512570992*^9, 
