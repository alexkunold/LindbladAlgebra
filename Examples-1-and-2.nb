Cell[TextData[{
 "The Lie and Jordan algebraic relations of ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " can be verified by evaluating the following differences, obtained by \
subtracting the right-hand side from the left-hand side of Eqs. (82) and \
(83), and verifying that they vanish identically.  This calculation may \
exceed the available memory if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "q"], TraditionalForm]],ExpressionUUID->
  "a32d81f2-36aa-4d85-96e9-525a40ce6032"],
 "\[GreaterSlantEqual]2."
}], "Text",
