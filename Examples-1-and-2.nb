Cell["\<\
These tests can also be performed in two special cases: (i) with the drive \
turned off; and (ii) with the Kossakowski matrix set to zero, yielding a \
unitary channel.\
\>", "Text",
 CellChangeTimes->{{4.001864082281296*^9, 4.001864113506687*^9}, {
   4.001864151970037*^9, 4.001864260809589*^9}, 4.0018643426163177`*^9, {
   4.001865132499898*^9, 4.0018651344883347`*^9}, {4.0018654230257463`*^9, 
   4.001865434903274*^9}},ExpressionUUID->"c51d2cdd-baac-43f9-986f-\
a5ebed51e747"],

Cell[CellGroupData[{

Cell["(i) drive turned off", "Subsubsection",
 CellChangeTimes->{{4.001864370686142*^9, 
  4.001864380386628*^9}},ExpressionUUID->"13b690f6-4d10-40b5-a4f5-\
98868d3339c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]0", " ", "=", 
   RowBox[{"2", "\[Pi]", " ", "0.05"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]0", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], "\[Pi]", " ", "0.3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]0", " ", "=", " ", 
   RowBox[{"2", "\[Pi]", " ", "3.0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"150.0", " ", 
    SuperscriptBox["10", "3"]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T2", "=", 
   RowBox[{"100.0", " ", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]10", "=", 
