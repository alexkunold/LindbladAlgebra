 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "0", 
      SqrtBox["2"], "0"},
     {"0", "0", "0", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       SqrtBox["2"]}]},
     {
      SqrtBox["2"], "0", "0", "0"},
     {"0", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox["2"]}], "0", "0"}
