Cell[TextData[{
 " We then transform it from the matrix basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicE]", "n"], TraditionalForm]],ExpressionUUID->
  "9d57ddaa-94f3-402e-9c88-554e2d022c50"],
 ", defined in Eq. (12), to the basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[GothicH]",
     FontWeight->"Bold"], "n"], TraditionalForm]],ExpressionUUID->
  "9fb6aa77-252a-4b4d-9b4b-a7f3ab7a0bb2"],
 " using the unitary transformation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "09bd1e5f-2022-4f6d-8496-073d447d6dd5"],
 "=tr[",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],ExpressionUUID->
  "7afe38f9-f96a-4c42-a961-3749dc113ccc"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "j"], TraditionalForm]],ExpressionUUID->
  "68d8eee8-2c7c-4080-a2f7-5de2166d68b0"],
 "]"
}], "Text",
 CellChangeTimes->{
  4.001771112324121*^9},ExpressionUUID->"c23a9275-89f7-4a97-8b6c-\
bc4cfdfe4599"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{"ElementaryBasis", "[", "m", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"h", ".", 
      RowBox[{"Transpose", "[", "e", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ut", "=", 
   RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Lsmh", "=", 
  RowBox[{"u", ".", 
   RowBox[{"(", 
    RowBox[{"Lsme", ".", "ut"}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{4.001763969511879*^9, 4.0017639907045507`*^9}, {
  4.0017640271236897`*^9, 4.0017640459463778`*^9}, {4.001764102824362*^9, 
